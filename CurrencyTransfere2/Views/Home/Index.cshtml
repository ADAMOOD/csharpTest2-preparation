@model CurrencyTransfere2.Models.ExchangeViewModel

<div class="text-center">
    <h1 class="display-4">Prevedte si meny</h1>
    <div asp-validation-summary="All" class="text-danger"></div> @* asp-validation All vypise vsechny validacni errory naseho view modelu *@
    <form method="post" name="exchange">
        <input type="text" asp-for="Name" placeholder="Jmeno" />@* Asp-for je chytrejsi Name musi tu byt stejne jmena jako ve ViewModelu *@
        <input type="email" asp-for="Email" placeholder="E-mail" />
        <select asp-for="SelectedCurrency">
            @{
                foreach (var currency in @Model.Currency.Currency)
                {
                    <option value="@currency.Key">@currency.Key</option>
                }
            }
        </select>
        <input type="number" step="0.01" name="ammount" placeholder="castka" asp-for="Ammount" />
        <input type="submit" />
    </form>
    <h2>
        @Model.Result
    </h2>

</div>
