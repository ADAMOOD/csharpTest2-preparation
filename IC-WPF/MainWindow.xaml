<Window x:Class="IC_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IC_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="MainWindow_OnLoaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"> </RowDefinition>
            <RowDefinition Height="Auto"> </RowDefinition>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Text ="zadejte IC" Margin="10" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"></TextBlock>
        <TextBox x:Name="IcTB" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="10" PreviewTextInput="IcTB_OnPreviewDragEnter"></TextBox>
        <Button Grid.Row="1" x:Name="Button" Grid.Column="1" VerticalAlignment="Center" Margin="50,10,50,10" Click="ButtonBase_OnClick" >Odeslat</Button>
    <DataGrid Grid.Column="1" Grid.Row="2" x:Name="DataGrid" ></DataGrid>
    </Grid>
</Window>