@model Gemin.Models.Company

<form method="post">
    <div asp-validation-summary="All"></div>
    <input type="text" asp-for="Name" placeholder="Nazev firmy" />
    <input type="text" asp-for="DIC" placeholder="DIC firmy" />
    <input type="number" asp-for="EmployeeCount" placeholder="Pocet zamestnancu " value="1" />
    <select asp-for="CompanyType">
        @{
            foreach (var type in Enum.GetValues(typeof(CompanyTypes)))
            {
                <option>@type</option>
            }
        }
    </select>
    <input type="text" placeholder="poznamka..." asp-for="@Model.Notes"/>
    <input type="submit" value="vytvorit firmu"/>
</form>