@model IEnumerable<FinancialOfice.Models.Office>
@{
    ViewData["Title"] = "Home Page";
}
<div>
    @{
        if (TempData["SuccessMessage"] is not null)
        {
            <div class="alert-success">@TempData["SuccessMessage"] </div>
        }
        else if (TempData["ErrorMessage"] is not null)
        {
            <div class="alert-danger">@TempData["ErrorMessage"] </div>
        }
    }
</div>
<div class="text-center">
    <h1 class="display-4">Financni urady</h1>
    <ul>
        @{
            foreach (var office in @Model)
            {
                <li> <a asp-action="Detail" asp-route-chodnota="@office.Chodnota"> @office.Name</a></li>
            }
        }
    </ul>
</div>
