@model FinalGeminiBossFight.Models.FormViewModel

<form method="post">
    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="CurrencyCode"/>
    <input type="text" asp-for="Name" placeholder="Jmeno prijemce"/>
    <input type="email" asp-for="Email" placeholder="email" />
    <input type="number" step="0.01" asp-for="Ammount" placeholder="castka" value="0.01"/>
    <input type="text" asp-for="AccountNumber" placeholder="cislo Uctu" />
    <input type="submit" />
</form>
